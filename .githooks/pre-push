#!/usr/bin/env bash
# Bloquea un push que toca index.html (la página que convierte) sin una marca
# de "baseline" en el diff -- el problema real del 17-ago no fue el copy en
# sí, fue que 14 commits se pushearon el mismo día sin que nadie anotara el
# número de ANTES. Dos semanas después, comparar era imposible.
#
# Convención: cualquier línea AGREGADA en el diff de index.html que contenga
# la palabra "baseline" (sin importar mayúsculas) cuenta como marca. Uso
# esperado: un comentario HTML cerca del cambio, con el número real del día,
# no un placeholder -- ej. "<!-- 1-sep: baseline scroll_precio=9/día,
# cta_activar=0/semana. Comparar en 2 semanas. -->".
#
# ⚠️ LÍMITE, desde el día uno: esto es un hook LOCAL (vive en .githooks/,
# git config core.hooksPath). Protege un push hecho desde ESTA máquina con
# este hook instalado -- NO protege un push desde otra máquina sin el mismo
# config, ni una edición hecha directo en github.com (el editor web de
# GitHub commitea sin pasar por ningún hook local). No es un gate de CI
# porque este repo no tiene CI. Sirve para el caso normal (Ricardo o Claude
# Code empujando desde este Mac), no como garantía absoluta.
#
# Para saltarlo a propósito (un cambio que de verdad no toca nada de
# conversión: un typo, un link roto): git push --no-verify.
#
# 17-sep-2026: mismo fix que el gemelo servidor (.github/workflows/
# index-baseline-check.yml) -- la línea de `marca` encadenaba dos greps en
# pipe bajo `pipefail`, donde el segundo (-q) puede cortar la lectura del
# primero apenas encuentra su match, generando SIGPIPE. Se probó (bash 3.2
# de este Mac, gemelo servidor corre bash 5.x de Ubuntu) que la semántica de
# pipefail+SIGPIPE difiere entre versiones -- el fix no depende de acertarle
# a cuál versión es "correcta", evita el patrón entero (un solo grep, sin
# consumidor que corte la lectura de un productor).
set -euo pipefail

zero="0000000000000000000000000000000000000000"
bloqueado=0
detalle=""

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue  # borrando una ref, nada que revisar

  if [ "$remote_sha" = "$zero" ]; then
    # rama/ref nueva en el remoto: no hay punto de comparación previo real,
    # se compara contra el árbol vacío (git diff --root) para no reventar.
    rango_diff=(--root "$local_sha")
    rango_names=(--root "$local_sha")
  else
    rango_diff=("$remote_sha..$local_sha")
    rango_names=("$remote_sha..$local_sha")
  fi

  tocado=$(git diff --name-only "${rango_names[@]}" -- index.html 2>/dev/null || true)
  [ -z "$tocado" ] && continue  # index.html no cambia en este push

  diff_index_html=$(git diff "${rango_diff[@]}" -- index.html 2>/dev/null || true)
  marca=$(grep -iqE '^\+.*baseline' <<< "$diff_index_html" && echo si || echo no)
  if [ "$marca" = "no" ]; then
    bloqueado=1
    detalle="$detalle  - $local_ref ($remote_sha..$local_sha)\n"
  fi
done

if [ "$bloqueado" = "1" ]; then
  cat >&2 <<MSG

🔴 PUSH BLOQUEADO: toca index.html (la página que convierte) sin una marca
   de "baseline" en el diff.
$(printf '%b' "$detalle")
   El 17-ago, 14 commits de copy se pushearon juntos sin que nadie anotara
   el número del día antes -- dos semanas después, nadie podía comparar si
   algo cambió. Esto existe para que no se repita.

   QUÉ ANOTAR Y DÓNDE: un comentario HTML cerca del cambio, con la palabra
   "baseline" y el número REAL de hoy (no un placeholder) -- sacalo de
   Umami o del reporte semanal antes de commitear de nuevo:

     <!-- 1-sep: baseline scroll_precio=9/día, cta_activar=0/semana.
          Comparar de acá a 2 semanas. -->

   Si de verdad no aplica (un typo, un link roto, nada que toque
   conversión): git push --no-verify -- pero esa decisión es tuya, el hook
   no la puede tomar por vos.

MSG
  exit 1
fi

exit 0
