#!/usr/bin/env bash
# commit-msg (21-nov-2026): todo mensaje de commit lleva una línea «Verificado: ...» (qué se corrió y qué se vio) o «Verificado: ninguna — porque ...». Exentos: los merges de git (los reconoce por MERGE_HEAD, no por el asunto: un commit normal que empieza con «Merge » sí lleva la línea).
# Los commits de bots en GitHub Actions no pasan por este hook (es local). Se activa con core.hooksPath=.githooks. Nunca saltarlo. Lo prueba githook-commit-msg-check.sh.
[ -f "$(git rev-parse --git-path MERGE_HEAD)" ] && exit 0
cuerpo=$(grep -v '^#' "$1")
t=$(printf '%s\n' "$cuerpo" | grep -E '^Verificado: ' | tail -n 1 | sed 's/^Verificado: *//')
if [ ${#t} -ge 5 ]; then
    case "$t" in
        [Nn]inguna*)
            if printf '%s\n' "$t" | grep -qE '^ninguna [—–-]+ porque .{3,}'; then
                # 27-nov-2026: «ninguna» solo si todo el commit es de documentos (docs/ o .md). --no-renames: mover código a docs/ cuenta la ruta vieja.
                # ponytail: en un --amend solo se mira lo agregado en este paso; git no le dice al hook que es un amend.
                codigo=$(git -c core.quotePath=false diff --cached --name-only --no-renames | grep -v -E '^docs/|\.md$' || true)
                [ -z "$codigo" ] && exit 0
                echo "COMMIT RECHAZADO: «Verificado: ninguna» solo vale si todo el commit es de documentos (docs/ o .md). Corre la comprobación y escribe lo que viste. No son documentos:" >&2
                echo "$codigo" | sed 's/^/  /' >&2
                exit 1
            fi ;;
        *) exit 0 ;;
    esac
fi
echo "COMMIT RECHAZADO: falta la línea «Verificado: ...» al final del mensaje (antes de los Co-Authored-By). Escríbela con lo que corriste y lo que viste, por ejemplo «Verificado: verify (12 tests dirigidos ok, 48 s)» o «Verificado: suite completa 7251 ok»; si no se comprobó nada: «Verificado: ninguna — porque <la causa>»." >&2
exit 1
